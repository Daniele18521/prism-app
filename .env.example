# =============================================================================
# PRISM frontend (.env) — copia in .env e adatta i valori
# =============================================================================

# Ambiente Node (development | production)
NODE_ENV=development

# Porta server Express frontend
PORT=3000

# -----------------------------------------------------------------------------
# MOCK FRONTEND (blueprint mock PRISM)
# -----------------------------------------------------------------------------
# Variabile ufficiale su questo stack Express+EJS (non-Vite):
#   PRISM_USE_MOCK
#
# Equivalente documentato rispetto al blueprint Vite:
#   VITE_PRISM_USE_MOCK  →  qui usa PRISM_USE_MOCK
#
# Parsing FE (in public/prism-mock-layer.js):
#   true | 1 | yes  → mock ON  (niente chiamate backend reali per
#                     prepare-shaping / jobs/status / regenerate-tone-surgical;
#                     jobId = mock_<uuid>; scrittura contents/{jobId} con isMock:true)
#   false | 0 | assente → flusso REALE verso API PRISM (zero scritture mock)
#
# ATTENZIONE: lasciare false in produzione.
PRISM_USE_MOCK=false
