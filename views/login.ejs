<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRISM - Autenticazione</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* --- STESSI IDENTICI COLORI E PRESET DELLA DASHBOARD --- */
        :root {
            --bg-color: #000000;
            --input-bg: #0d0d0d;
            --border-grey: #262626;
            --text-main: #ffffff;
            --text-dim: #71717a;
            --accent-blue: #2563eb;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        } 

        /* --- CARD DI LOGIN SEMPLIFICATA PER IL SINGLE SIGN-ON --- */
        .login-card {
            background: rgba(255, 255, 255, 0.01);
            border: 1px solid var(--border-grey);
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        .logo-area {
            display: flex;
            justify-content: center;
            margin-bottom: 30px;
        }

        .logo-img {
            height: auto;
            width: 140px;
            display: block;
        }

        .auth-subtitle {
            font-size: 13px;
            color: var(--text-dim);
            margin-top: -15px;
            margin-bottom: 35px;
            line-height: 1.6;
        }

        /* --- PULSANTE ACCESSO GOOGLE PREMIUM --- */
        .google-btn {
            width: 100%;
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-main);
            border: 1px solid var(--border-grey);
            padding: 16px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: background 0.2s, border-color 0.2s, opacity 0.2s;
            margin-top: 10px;
        }
        .google-btn:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: var(--text-main);
        }
        .google-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* --- ALERT BOX INTERNO --- */
        .alert-box {
            display: none;
            padding: 12px;
            border-radius: 6px;
            font-size: 12px;
            margin-bottom: 25px;
            line-height: 1.4;
            text-align: left;
        }
        .alert-error { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #f87171; }
        .alert-success { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #34d399; }

        /* --- FOOTER INFORMATIVO SULLA CONFIGURAZIONE --- */
        .info-footer {
            margin-top: 35px;
            padding-top: 20px;
            border-top: 1px solid var(--border-grey);
            font-size: 11px;
            color: var(--text-dim);
            line-height: 1.5;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-area">
            <img src="/images/logo_senza_scritta_piccola.png" alt="PRISM Logo" class="logo-img">
        </div>
        
        <p class="auth-subtitle">Accedi o inizializza il tuo spazio di lavoro professionale tramite autenticazione sicura Google.</p>

        <div id="alert-box" class="alert-box"></div>

        <!-- Unico punto di accesso del sistema: login e onboarding automatico integrati -->
        <button type="button" id="google-auth-btn" onclick="handleGoogleAuth()" class="google-btn">
            <i class="fab fa-google"></i> Continua con Google
        </button>

        <div class="info-footer">
            Selezionando Google, PRISM configurerà automaticamente un ambiente dedicato (fino a 10 analisi e 5 rigenerazioni incluse).
        </div>
    </div>

    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <script src="/prism-error-popup.js"></script>
    <script src="/firebase-config.js"></script>
    <script>
        // Inizializziamo la configurazione client-side di Firebase passando la variabile d'ambiente
        initFirebaseConfig("<%= env %>");
    </script>

    <script>
        // Registriamo un ascoltatore per eseguire la logica non appena il DOM è completamente pronto
        window.addEventListener('DOMContentLoaded', () => {
            // Estraiamo i parametri analizzando la query string dell'URL corrente
            const urlParams = new URLSearchParams(window.location.search);
            // Se l'URL riporta un errore dovuto a un profilo non trovato su Firestore
            if (urlParams.get('error') === 'profile_not_found') {
                if (typeof window.showPrismError === 'function') {
                    showPrismError('Profilo non registrato su Firestore.', { title: 'Accesso non riuscito' });
                } else {
                    showAlert("error", "Profilo non registrato su Firestore.");
                }
            } else if (urlParams.get('error') === 'no_company_assigned') {
                if (typeof window.showPrismError === 'function') {
                    showPrismError('Nessun cluster aziendale associato a questa utenza.', { title: 'Accesso non riuscito' });
                } else {
                    showAlert("error", "Nessun cluster aziendale associato a questa utenza.");
                }
            }
        });

        /**
         * Mostra un avviso all'utente impostando il colore e la formattazione corretta del box.
         * @param {string} type - Tipo di alert ('error' oppure 'success').
         * @param {string} message - Il messaggio testuale da inserire nel box.
         */
        function showAlert(type, message) {
            // Recuperiamo il riferimento all'elemento HTML adibito a contenitore degli avvisi
            const box = document.getElementById('alert-box');
            // Aggiorniamo il contenuto testuale inserendo il messaggio di notifica
            box.innerText = message;
            // Rendiamo visibile l'elemento modificandone la proprietà css display
            box.style.display = "block";
            // Assegniamo le classi grafiche corrispondenti per applicare i colori di errore o successo
            box.className = `alert-box ${type === 'error' ? 'alert-error' : 'alert-success'}`;
        }

        /**
         * Gestisce l'intera procedura di autenticazione client-side con Google Provider.
         * Effettua in modo trasparente l'onboarding (scrittura Batch) se l'utente non esiste a database.
         */
        async function handleGoogleAuth() {
            // Recuperiamo il riferimento al pulsante di autenticazione per poterne controllare lo stato
            const btn = document.getElementById('google-auth-btn');
            // Disabilitiamo il pulsante per prevenire clic ripetuti accidentali durante la transazione
            btn.disabled = true;
            // Inizializziamo l'istanza del provider Google per Firebase Authentication
            const provider = new firebase.auth.GoogleAuthProvider();
            try {
                // Apriamo la finestra popup nativa per completare l'autenticazione con Google
                const result = await firebase.auth().signInWithPopup(provider);
                // Estraiamo i dati dell'utente autenticato dal record restituito da Firebase
                const user = result.user;

                // Prepariamo la query leggendo il documento dell'utente all'interno della raccolta 'users'
                const userRef = window.db.collection("users").doc(user.uid);
                // Effettuiamo la chiamata di lettura su Firestore per recuperare lo snapshot del profilo
                const userDoc = await userRef.get();

                // Se l'utente non è censito nel database (nuovo iscritto), avviamo l'onboarding
                if (!userDoc.exists) {
                    // Generiamo l'ID Company univoco basandoci sul formato camelCase concordato
                    const generatedCompanyId = `company_${user.uid}`;
                    // Avviamo un'operazione batch per garantire l'atomicità della doppia scrittura
                    const batch = window.db.batch();

                    // Definiamo il riferimento per la creazione del documento Company associato
                    const companyRef = window.db.collection("companies").doc(generatedCompanyId);
                    // Prepariamo la scrittura dei dati aziendali con i parametri del piano Free
                    batch.set(companyRef, {
                        name: `Workspace - ${user.email}`,       // Nome provvisorio del workspace aziendale
                        stripeCustomerId: null,                   // ID cliente Stripe (inizialmente nullo)
                        stripeSubscriptionId: null,               // ID abbonamento Stripe (inizialmente nullo)
                        subscriptionStatus: "free",               // Impostiamo lo stato iniziale
                        tier: "free",                             // Definiamo il livello di servizio iniziale
                        enabled_tones: [                          // Abilitiamo l'array dei toni base gratuiti
                            "provocatore", 
                            "confidente",
                            "sferzante",
                            "visionario",
                            "metodologico",
                            "narratore"
                            "promotore",
                        ],
                        generations_left: 10,                     // Impostiamo il limite iniziale di 50 analisi
                        regenerations_left: 5,                  // Impostiamo il limite iniziale di 100 rigenerazioni
                        created_at: firebase.firestore.FieldValue.serverTimestamp(), // Timestamp di creazione
                        updated_at: firebase.firestore.FieldValue.serverTimestamp()  // Timestamp di aggiornamento
                    });

                    // Prepariamo la scrittura del profilo utente agganciato alla nuova Company
                    batch.set(userRef, {
                        email: user.email,                        // Indirizzo email ufficiale ricavato da Google
                        companyId: generatedCompanyId,            // Riferimento chiave esterna (camelCase)
                        user_guide: true,                         // Impostiamo il flag per la guida utente
                        role: "owner",                            // Ruolo amministrativo impostato a Owner
                        user_profile: "admin",                    // Profilo operativo impostato ad Admin
                        custom_enabled_tones: null,               // Nessun override personalizzato sui toni
                        created_at: firebase.firestore.FieldValue.serverTimestamp(), // Timestamp di creazione
                        updated_at: firebase.firestore.FieldValue.serverTimestamp()  // Timestamp di aggiornamento
                    });

                    // Eseguiamo il commit del batch scrivendo contemporaneamente entrambi i documenti
                    await batch.commit();
                }

                // Memorizziamo in modo sicuro l'UID dell'utente autenticato nella sessione del browser
                sessionStorage.setItem("prism_user_uid", user.uid);
                // Informiamo l'utente dell'avvenuto completamento della sessione
                showAlert("success", "Accesso con Google eseguito! Reindirizzamento...");
                // Effettuiamo il redirect verso la Dashboard operativa di PRISM dopo un breve delay visivo
                setTimeout(() => { window.location.href = "/dashboard"; }, 800);
            } catch (error) {
                // Intercettiamo eventuali eccezioni ripristinando lo stato del pulsante
                btn.disabled = false;
                // Mostriamo la notifica con l'errore descrittivo generato durante il login
                if (typeof window.showPrismError === 'function') {
                    showPrismError(`Errore Google Sign-In: ${error.message}`, { title: 'Accesso non riuscito' });
                } else {
                    showAlert("error", `Errore Google Sign-In: ${error.message}`);
                }
            }
        }
    </script>
</body>
</html>