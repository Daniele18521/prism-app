      "description": "Motore editoriale AI professionale basato su un sistema di rifrazione intelligente.",
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "EUR",
        "availability": "https://schema.org/PreOrder"
