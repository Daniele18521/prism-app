<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRISM - Archivio Contenuti</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #000000;
            --input-bg: #0d0d0d;
            --border-grey: #262626;
            --text-main: #ffffff;
            --text-dim: #71717a;
            --accent-blue: #2563eb;
            --rainbow: linear-gradient(to right, #3b82f6, #10b981, #f59e0b, #ef4444, #a855f7, #ec4899);
        }

        body { background: var(--bg-color); color: var(--text-main); font-family: 'Inter', sans-serif; padding: 20px 40px; margin: 0; }
        
        /* Header */
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .logo-img { width: 110px; height: auto; }

        /* Search Section */
        .search-container {
            background: #09090b; border: 1px solid var(--border-grey); border-radius: 12px;
            padding: 25px; margin-bottom: 30px; display: flex; flex-direction: column; gap: 20px;
        }
        .filter-row { display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap; }
        .input-group { display: flex; flex-direction: column; gap: 8px; }
        label { font-size: 11px; text-transform: uppercase; color: var(--text-dim); letter-spacing: 1px; }
        input[type="date"], input[type="text"] {
            background: var(--input-bg); border: 1px solid var(--border-grey);
            color: #fff; padding: 10px; border-radius: 8px; outline: none;
        }
        .search-btn {
            background: var(--accent-blue); color: #fff; border: none; padding: 10px 25px;
            border-radius: 8px; font-weight: 700; cursor: pointer; text-transform: uppercase;
        }

        /* Results */
        .archive-list { display: flex; flex-direction: column; gap: 15px; }
        .topic-card {
            background: #0d0d0d; border: 1px solid var(--border-grey); border-radius: 10px;
            overflow: hidden; transition: all 0.3s;
        }
        .card-header {
            padding: 18px 25px; display: flex; justify-content: space-between; align-items: center;
            cursor: pointer; background: rgba(255,255,255,0.02);
        }
        .card-header:hover { background: rgba(255,255,255,0.05); }
        .topic-title { font-weight: 700; font-size: 16px; color: #f4f4f5; }
        .topic-meta { font-size: 12px; color: var(--text-dim); }

        .card-content { display: none; padding: 20px; border-top: 1px solid var(--border-grey); background: #050505; }
        .card-content.active { display: block; }

        /* Tones Grid inside card */
        .tones-subgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
        .tone-item {
            background: #111; border: 1px solid var(--border-grey); border-radius: 8px;
            padding: 15px; cursor: pointer; position: relative;
        }
        .tone-item:hover { border-color: var(--accent-blue); }
        .history-badge {
            position: absolute; top: -5px; right: -5px; background: #f59e0b;
            color: #000; font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 10px;
        }

        /* Modals */
        .modal-overlay { 
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); z-index: 10000;
            display: none; align-items: center; justify-content: center;
        }
        .modal-content {
            background: #0d0d0d; border: 1px solid var(--border-grey); border-radius: 12px;
            width: 90%; max-width: 800px; max-height: 85vh; overflow-y: auto; padding: 30px;
        }

        /* Comparison Modal */
        .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .compare-pane { background: #050505; padding: 20px; border-radius: 8px; border: 1px solid var(--border-grey); }
        .compare-meta { font-size: 11px; color: var(--accent-blue); margin-bottom: 10px; text-transform: uppercase; }

        .pagination { display: flex; justify-content: center; gap: 15px; margin-top: 30px; align-items: center; }
        
        .version-list-item {
            display: flex; justify-content: space-between; padding: 10px; border-bottom: 1px solid #1a1a1a;
            cursor: pointer; font-size: 13px;
        }
        .version-list-item:hover { background: rgba(255,255,255,0.05); }

        .compare-checkbox { margin-right: 10px; }
    </style>
</head>
<body>

    <header>
        <img src="/images/logo_senza_sfondo.png" class="logo-img" alt="PRISM">
        <nav style="display:flex; gap:20px">
            <a href="/dashboard" style="color:var(--text-dim); text-decoration:none; font-size:14px">Torna alla Dashboard</a>
        </nav>
    </header>

    <main>
        <div class="search-container">
            <div class="filter-row">
                <div class="input-group">
                    <label>Data Da</label>
                    <input type="date" id="dateFrom">
                </div>
                <div class="input-group">
                    <label>Data A</label>
                    <input type="date" id="dateTo">
                </div>
                <button class="search-btn" onclick="fetchArchive()">Ricerca <i class="fas fa-search"></i></button>
            </div>
            
            <div class="input-group">
                <label>Filtra per Argomento (min. 3 caratteri)</label>
                <input type="text" id="topicFilter" placeholder="Cerca tra i risultati..." oninput="liveFilter()">
            </div>
        </div>

        <div id="results-container" class="archive-list">
            <!-- Qui verranno iniettate le card -->
        </div>

        <div class="pagination" id="pagination-controls">
            <!-- Qui verranno iniettati i bottoni paginazione -->
        </div>
    </main>

    <!-- Modale Versioni -->
    <div id="version-modal" class="modal-overlay">
        <div class="modal-content">
            <h2 id="version-modal-title" style="margin-bottom:20px;">Versioni Tono</h2>
            <div id="version-list"></div>
            <div style="margin-top:20px; display:flex; justify-content:space-between">
                <button onclick="closeModal('version-modal')" class="search-btn" style="background:#27272a">Chiudi</button>
                <button id="compare-trigger-btn" onclick="openComparison()" class="search-btn" style="display:none">Confronta Selezionati</button>
            </div>
        </div>
    </div>

    <!-- Modale Contenuto Singolo -->
    <div id="content-modal" class="modal-overlay">
        <div class="modal-content">
            <div id="single-content-render"></div>
            <button onclick="closeModal('content-modal')" class="search-btn" style="margin-top:20px">Chiudi</button>
        </div>
    </div>

    <!-- Modale Confronto -->
    <div id="compare-modal" class="modal-overlay">
        <div class="modal-content" style="max-width: 1200px;">
            <div class="compare-grid" id="compare-render"></div>
            <button onclick="closeModal('compare-modal')" class="search-btn" style="margin-top:20px">Chiudi</button>
        </div>
    </div>

    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
    <script src="/firebase-config.js"></script>
    <script>
        initFirebaseConfig("<%= env %>");
    </script>
    <script src="/archive.js"></script>
</body>
</html>