<!-- START OF FILE dashboard.ejs -->

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRISM - Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #000000;
            --input-bg: #0d0d0d;
            --border-grey: #262626;
            --text-main: #ffffff;
            --text-dim: #71717a;
            --accent-blue: #2563eb;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', -apple-system, sans-serif;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
            /* Padding inferiore aggiuntivo per fare spazio al footer fisso ed evitare sovrapposizioni di contenuto */
            padding-bottom: 80px;
        }

        /* --- HEADER (barra integrata col resto della pagina) --- */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            max-width: 1050px;
            margin: 0 auto;
            padding: 8px 40px 7px;
            position: relative;
            z-index: 5;
        }

        header img {
            width: 72px;
            height: auto;
            display: block;
        }

        header::after {
            content: '';
            position: absolute;
            left: 40px;
            right: 40px;
            bottom: 0;
            height: 2px;
            border-radius: 2px;
            background: linear-gradient(to right, #3b82f6, #f59e0b, #ef4444, #a855f7, #ec4899, #06b6d4);
            box-shadow: 0 0 14px rgba(59, 130, 246, 0.25);
            opacity: 0.95;
        }

        .nav-right { display: flex; gap: 18px; font-size: 12px; align-items: center; }
        .nav-right span { cursor: pointer; color: var(--text-dim); transition: color 0.2s; }
        .nav-right span:hover { color: #fff; }

        /* --- AREA INPUT --- */
        .input-flex-container {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            gap: 20px;
            width: 100%;
            max-width: 1050px;
            margin: 18px auto 20px auto;
            padding: 0 40px;
        }

        .input-box {
            flex: 1;
            max-width: 800px;
            position: relative;
            background: linear-gradient(180deg, rgba(255,255,255,0.03) 0%, rgba(13,13,13,0.92) 28%);
            border: 1px solid var(--border-grey);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        }

        .rainbow-line {
            display: none; /* la rainbow vive sotto l'header per unire chrome e contenuto */
        }

        textarea, #topicInput {
            width: 100%;
            height: 120px;
            min-height: 120px;
            max-height: 120px;
            background: transparent;
            border: none;
            color: #fff;
            padding: 20px;
            font-size: 16px;
            resize: none;
            outline: none;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.14) transparent;
        }

        #topicInput::-webkit-scrollbar {
            width: 6px;
        }

        #topicInput::-webkit-scrollbar-track {
            background: transparent;
        }

        #topicInput::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.14);
            border-radius: 10px;
        }

        #topicInput::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.24);
        }

        .input-info {
            display: flex; justify-content: flex-end;
            padding: 10px 20px; font-size: 12px; color: var(--text-dim);
        }

        /* --- BOTTONI AZIONE --- */
        .side-actions { display: flex; flex-direction: column; gap: 10px; width: 180px; }

        .generate-btn {
            background: var(--accent-blue); color: #fff;
            border: none; padding: 14px; border-radius: 8px;
            font-weight: 700; font-size: 13px; cursor: pointer;
            text-transform: uppercase; transition: all 0.3s;
            opacity: 0.3; /* Inizialmente spento */
        }

        .reset-btn {
            background: transparent; border: 1px solid var(--border-grey);
            color: var(--text-dim); padding: 10px; border-radius: 8px;
            font-size: 11px; font-weight: 600; cursor: pointer;
            text-transform: uppercase; display: flex;
            align-items: center; justify-content: center; gap: 8px;
            opacity: 0.3;
        }

        .reset-btn:hover { border-color: #ef4444; color: #ef4444; }

        /* --- SETTINGS (BLOCCATI INITIAL) --- */
        .settings-row {
            display: flex; justify-content: center; align-items: center; gap: 40px;
            margin: 0 auto 30px auto;
            width: 100%;
            max-width: 1050px;
            padding: 0 40px;
            pointer-events: none; opacity: 0.5;
        }

        .platform-pill {
            background: #18181b; border: 1px solid #27272a;
            border-radius: 30px; padding: 4px; display: flex; gap: 5px;
        }

        .pill {
            padding: 8px 15px; border-radius: 20px; font-size: 13px;
            cursor: pointer; color: var(--text-dim); display: flex; align-items: center; gap: 6px;
        }
        .pill.active { background: #3f3f46; color: #fff; }

        /* Colori brand ufficiali solo sulle icone (riferimento funzionale piattaforma) */
        .platform-pill .pill .fa-facebook,
        .overlay-platform-pill .pill .fa-facebook {
            color: #1877F2;
        }
        .platform-pill .pill .fa-linkedin,
        .overlay-platform-pill .pill .fa-linkedin {
            color: #0A66C2;
        }
        .platform-pill .pill .fa-x-twitter,
        .overlay-platform-pill .pill .fa-x-twitter {
            color: #E7E9EA; /* X brand su UI scura */
        }

        .platform-pill.platform-locked {
            cursor: not-allowed;
        }

        .platform-pill.platform-locked .pill {
            cursor: not-allowed;
        }

        .lang-pill {
            background: #18181b; border: 1px solid #27272a;
            border-radius: 30px; padding: 4px; display: flex; gap: 5px;
        }

        .lang-pill.lang-locked {
            cursor: not-allowed;
        }

        .lang-pill.lang-locked .pill {
            cursor: not-allowed;
        }

        .lang-pill .lang-flag,
        .overlay-lang-pill .lang-flag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            line-height: 1;
        }

        .lang-pill .lang-flag-img,
        .overlay-lang-pill .lang-flag-img {
            width: 18px;
            height: 13px;
            object-fit: cover;
            border-radius: 2px;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
            display: block;
        }

        .lang-select { background: #000; border: 1px solid #3f3f46; color: #fff; padding: 8px 15px; border-radius: 20px; font-size: 14px; }

        /* --- GRID TONI & LOCK SYSTEM --- */
        .tones-grid {
            display: grid; grid-template-columns: repeat(7, 1fr);
            gap: 12px;
            margin: 0 auto 40px auto;
            width: 100%;
            max-width: 1050px;
            padding: 0 40px;
        }

        .tone-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-grey);
            border-radius: 8px; padding: 22px 16px;
            text-align: center; opacity: 0.2; 
            cursor: not-allowed; position: relative;
            transition: all 0.4s ease;
        }

        .tone-card.enabled {
            opacity: 1; cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-left: 5px solid var(--card-color) !important;
        }

        .tone-card.enabled.tone-unavailable {
            opacity: 1;
            cursor: pointer;
            background: rgba(255, 255, 255, 0.09);
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            border-left: 3px solid rgba(255, 255, 255, 0.35) !important;
            border-left-color: rgba(255, 255, 255, 0.35) !important;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }

        .tone-card.enabled.tone-unavailable:hover {
            animation: none !important;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12) !important;
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.26) !important;
            border-left-color: rgba(255, 255, 255, 0.4) !important;
        }

        .tone-card.enabled.tone-unavailable i.icon-top {
            color: #f4f4f5 !important;
            filter: none !important;
            opacity: 0.85;
        }

        .tone-card.enabled.tone-unavailable h3 {
            color: #e4e4e7;
            font-weight: 600;
        }

        .tone-card.locked-by-plan {
            opacity: 0.25 !important;
            filter: grayscale(0.8);
        }

        .tone-card.tone-loading {
            pointer-events: wait;
            opacity: 0.65;
        }

        /* --- LOCK BADGE 3D BI-METALLO --- */
        .lock-badge {
            position: absolute; top: 12px; right: 12px; font-size: 20px; 
            background: linear-gradient(180deg, #e5e7eb 0%, #9ca3af 42%, #fde047 42%, #ca8a04 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            filter: drop-shadow(2px 3px 2px rgba(0,0,0,0.7));
            opacity: 1; display: none; z-index: 5;
        }

        .tone-card.locked-by-plan .lock-badge { display: block; }

        /* Colori semantici — allineati alla rainbow-line */
        .t-provocatore { --card-color: #3b82f6; --card-glow: rgba(59, 130, 246, 0.5); }
        .t-confidente { --card-color: #f59e0b; --card-glow: rgba(245, 158, 11, 0.5); }
        .t-sferzante { --card-color: #ef4444; --card-glow: rgba(239, 68, 68, 0.5); }
        .t-visionario { --card-color: #a855f7; --card-glow: rgba(168, 85, 247, 0.5); }
        .t-metodologico { --card-color: #ec4899; --card-glow: rgba(236, 72, 153, 0.5); }
        .t-narratore { --card-color: #06b6d4; --card-glow: rgba(6, 182, 212, 0.5); }
        .t-promotore { --card-color: #10b981; --card-glow: rgba(16, 185, 129, 0.5); }

        .tone-card.enabled:not(.tone-unavailable):hover {
            animation: tone-card-blink 1.3s ease-in-out infinite;
            border-color: var(--card-color) !important;
            background: rgba(255, 255, 255, 0.035);
        }

        @keyframes tone-card-blink {
            0%, 100% {
                box-shadow: 0 0 0 transparent;
            }
            50% {
                box-shadow: 0 0 14px var(--card-glow), 0 0 28px var(--card-glow);
            }
        }

        .tone-card i.icon-top { font-size: 32px; color: var(--text-dim); margin-bottom: 15px; }
        .tone-card.enabled:not(.tone-unavailable) i.icon-top { color: #fff; filter: drop-shadow(0 0 10px var(--card-color)); }
        .tone-card h3 { font-size: 13px; font-weight: 700; color: var(--text-dim); }
        .tone-card.enabled h3 { color: #fff; }

        /* --- MODALS --- */
        .modal-overlay { 
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(5, 5, 5, 0.9); backdrop-filter: blur(8px); 
            z-index: 9999; display: none; align-items: center; justify-content: center; 
        }

        /* Overlay analisi — layer bloccante con prisma olografico centrato */
        .prism-analysis-overlay {
            pointer-events: auto;
            cursor: wait;
        }

        .prism-analysis-stage {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            pointer-events: none;
        }

        #analysis-prism-loader {
            position: relative;
            top: auto;
            left: auto;
            transform: none;
            display: flex;
            opacity: 1;
            z-index: 2;
            transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                        transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                        filter 0.85s cubic-bezier(0.16, 1, 0.3, 1);
        }

        #analysis-prism-loader.dissolving {
            opacity: 0;
            transform: scale(1.1);
            filter: blur(10px);
        }

        #analysis-prism-loader.dissolving .prism-svg,
        #analysis-prism-loader.dissolving .prism-svg-container {
            animation: none;
        }

        #analysis-status-msg {
            max-width: 380px;
            text-align: center;
            line-height: 1.65;
            padding: 0 12px;
        }

        .analysis-progress-track {
            width: 280px;
            height: 4px;
            background: #18181b;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 18px;
            border: 1px solid #27272a;
        }

        .analysis-progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(to right, #3b82f6, #f59e0b, #ef4444, #a855f7, #ec4899, #06b6d4);
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.35);
            border-radius: 10px;
            transition: width 0.55s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* --- STICKY FOOTER DEI CREDITI --- */
        .credits-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: rgba(10, 10, 10, 0.9);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--border-grey);
            padding: 14px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
        }

        .credits-left-section {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-dim);
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .credits-right-section {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .credit-indicator {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: #d4d4d8;
        }

        .credit-indicator i {
            font-size: 14px;
        }

        .credit-val-box {
            font-weight: 700;
            background: #18181b;
            border: 1px solid #27272a;
            padding: 4px 10px;
            border-radius: 6px;
            min-width: 40px;
            text-align: center;
            color: #ffffff;
            transition: all 0.3s ease;
        }

        /* Stato critico / Crediti esauriti o quasi */
        .credit-val-box.low-credits {
            color: #ef4444 !important;
            border-color: rgba(239, 68, 68, 0.4) !important;
            background: rgba(239, 68, 68, 0.1) !important;
            box-shadow: 0 0 8px rgba(239, 68, 68, 0.2);
            animation: pulse-red-glow 2s infinite;
        }

        @keyframes pulse-red-glow {
            0% { box-shadow: 0 0 4px rgba(239, 68, 68, 0.2); }
            50% { box-shadow: 0 0 12px rgba(239, 68, 68, 0.5); }
            100% { box-shadow: 0 0 4px rgba(239, 68, 68, 0.2); }
        }

        /* ==========================================================================
           CONTENITORE MODALE OUTPUT & EFFETTO GLOW / PRISMA 3D VETTORIALE PREMIUM
           ========================================================================== */
        
        .output-modal-box {
            background: var(--bg-color);
            border: 1px solid var(--tone-border, var(--border-grey));
            padding: 35px;
            border-radius: 12px;
            /* Larghezza fissa: ospita fino a 7 toni in toolbar senza scrollbar orizzontale */
            width: 950px;
            max-width: calc(100vw - 40px);
            /* Altezza fissa: non cresce/rimpicciolisce mentre arriva il testo */
            height: 90vh;
            max-height: 90vh;
            /* La modale intera NON scorre: scroll solo su .modal-tone-scroll */
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 10;
            box-sizing: border-box;
            transition: border-color 0.8s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Bagliore perimetrale — colore del tono selezionato (--tone-* impostati via JS) */
        .output-modal-box.completed-glow {
            border-color: var(--tone-border, rgba(168, 85, 247, 0.35));
            box-shadow: 0 0 30px var(--tone-glow-1, rgba(37, 99, 235, 0.15)),
                        0 0 50px var(--tone-glow-2, rgba(168, 85, 247, 0.1)),
                        0 0 70px var(--tone-glow-1, rgba(6, 182, 212, 0.15));
        }

        /* Chrome azioni in alto a destra (expand / restore / dashboard / close) */
        .modal-chrome-actions {
            position: absolute;
            top: 16px;
            right: 18px;
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .modal-chrome-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 1px solid #27272a;
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-dim);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            transition: color 0.2s, border-color 0.2s, background 0.2s;
        }

        .modal-chrome-btn:hover {
            color: #fff;
            border-color: #3f3f46;
            background: rgba(255, 255, 255, 0.06);
        }

        .modal-chrome-btn.is-danger:hover {
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.45);
        }

        /* Modalità pagina intera: lascia visibili header + footer dashboard */
        #output-modal.tone-modal-fullscreen {
            top: var(--tone-fs-top, 72px);
            bottom: var(--tone-fs-bottom, 56px);
            left: 0;
            right: 0;
            width: 100%;
            height: auto;
            padding: 0;
            align-items: stretch;
            justify-content: stretch;
            background: var(--bg-color);
            z-index: 900;
        }

        #output-modal.tone-modal-fullscreen .output-modal-box {
            width: 100% !important;
            max-width: none;
            height: 100% !important;
            max-height: none;
            border-radius: 0;
            border-left: none;
            border-right: none;
            border-top: none;
            border-bottom: none;
        }

        body.tone-modal-fullscreen-active header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            max-width: none;
            margin: 0;
            z-index: 10050;
            background: var(--bg-color);
            /* Stesse dimensioni della dashboard: continuità visiva */
        }

        body.tone-modal-fullscreen-active .credits-footer {
            z-index: 10050;
        }

        #output-modal.tone-modal-fullscreen .modal-chrome-btn[data-action="expand"] {
            display: none;
        }

        #output-modal:not(.tone-modal-fullscreen) .modal-chrome-btn[data-action="restore"],
        #output-modal:not(.tone-modal-fullscreen) .modal-chrome-btn[data-action="dashboard"] {
            display: none;
        }

        /* Dettagli generazione (pannello estensione a destra) */
        .generation-details-panel {
            display: grid;
            gap: 10px;
            font-size: 12px;
            color: var(--text-dim);
            line-height: 1.45;
        }

        .generation-details-panel .meta-row {
            word-break: break-word;
        }

        .generation-details-panel .meta-row strong {
            color: #a1a1aa;
            font-weight: 600;
        }

        .generation-details-topic-wrap {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-height: 0;
        }

        .generation-details-topic-wrap label {
            color: #a1a1aa;
            font-weight: 600;
            font-size: 12px;
        }

        .generation-details-topic {
            width: 100%;
            box-sizing: border-box;
            min-height: 56px;
            max-height: 40vh;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #27272a;
            background: rgba(255, 255, 255, 0.02);
            color: #e4e4e7;
            font-size: 12px;
            line-height: 1.5;
            font-family: inherit;
            resize: none;
            outline: none;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.14) transparent;
        }

        .generation-details-empty {
            opacity: 0.7;
            font-style: italic;
            font-size: 12px;
        }

        /* Modulo di allineamento e posizionamento per prisma e caricamento testuale */
        .modal-loading-wrapper {
            position: absolute;
            top: 55%;
            left: 50%;
            transform: translate(-50%, -45%);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            pointer-events: none;
            z-index: 1;
            transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                        transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                        filter 0.85s cubic-bezier(0.16, 1, 0.3, 1);
        }

        #tone-gen-prism-loader.dissolving {
            opacity: 0 !important;
            transform: translate(-50%, -45%) scale(1.1);
            filter: blur(10px);
        }

        #tone-gen-prism-loader.dissolving .prism-svg,
        #tone-gen-prism-loader.dissolving .prism-svg-container {
            animation: none;
        }

        #tone-gen-status-msg {
            max-width: 380px;
            text-align: center;
            line-height: 1.65;
            padding: 0 12px;
        }

        .tone-gen-progress-track {
            width: 280px;
            height: 4px;
            background: #18181b;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 18px;
            border: 1px solid #27272a;
        }

        .tone-gen-progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(to right, #3b82f6, #f59e0b, #ef4444, #a855f7, #ec4899, #06b6d4);
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.35);
            border-radius: 10px;
            transition: width 0.55s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Contenitore per l'elemento Prisma vettoriale SVG che esegue l'oscillazione */
        .prism-svg-container {
            width: 190px;
            height: 190px;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: float-prism-v 5s ease-in-out infinite; /* Solo oscillazione verticale */
        }

        /* Elemento SVG che esegue la rotazione vettoriale corretta su asse Z */
        .prism-svg {
            width: 100%;
            height: 100%;
            animation: spin-prism-v 18s linear infinite; /* Solo rotazione */
        }

        /* Testo pulsante sottostante */
        .prism-loading-label {
            color: var(--text-dim);
            font-size: 13px;
            font-weight: 500;
            margin-top: 15px;
            letter-spacing: 0.8px;
            animation: pulse-text 2s ease-in-out infinite;
        }

        /* Animazioni vettoriali precise */
        @keyframes spin-prism-v {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes float-prism-v {
            0%, 100% { transform: translateY(0px) scale(0.96); }
            50% { transform: translateY(-10px) scale(1.04); }
        }

        @keyframes pulse-text {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

        /* --- Notifica errori globali --- */
        #global-error-notification {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(239, 68, 68, 0.92);
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            padding: 12px 40px;
            text-align: center;
            z-index: 99999;
            display: none;
            backdrop-filter: blur(6px);
            box-shadow: 0 4px 20px rgba(239, 68, 68, 0.35);
            letter-spacing: 0.3px;
        }

        /* ==========================================================================
           WORKSPACE SIDEBAR & LAYOUT MODALE A DUE COLONNE
           ========================================================================== */

        .modal-body-columns {
            display: flex;
            position: relative;
            z-index: 15;
            flex: 1;
            min-height: 0;
            align-items: stretch;
            overflow: hidden;
        }

        .modal-content-column {
            flex: 1;
            min-width: 0;
            min-height: 0;
            position: relative;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .modal-tone-switcher {
            display: none;
            /* Fissa in alto: tutti i toni visibili, nessuna scrollbar orizzontale */
            flex-wrap: nowrap;
            align-items: center;
            gap: 6px;
            overflow: hidden;
            padding-bottom: 12px;
            padding-right: 150px; /* spazio per expand / restore / dashboard / close */
            margin-bottom: 14px;
            border-bottom: 1px solid var(--border-grey);
            position: relative;
            z-index: 20;
            flex-shrink: 0;
            width: 100%;
            box-sizing: border-box;
        }

        .modal-tone-switcher-item {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 6px 8px;
            border-radius: 999px;
            border: 1px solid #27272a;
            background: #111;
            color: #d4d4d8;
            cursor: pointer;
            /* Si ripartiscono lo spazio: fino a 7 toni senza overflow/scroll */
            flex: 1 1 0;
            min-width: 0;
            max-width: 100%;
            font-size: 11px;
            font-weight: 600;
            font-family: inherit;
            transition: all 0.2s;
        }

        .modal-tone-switcher-item .tone-mini-label {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            min-width: 0;
        }

        .modal-tone-switcher-item:hover:not(:disabled):not(.loading) {
            border-color: #444;
            color: #fff;
        }

        .modal-tone-switcher-item.active {
            border-color: var(--tone-item-color, var(--tone-accent, #a855f7));
            background: rgba(255, 255, 255, 0.04);
            color: #fff;
            box-shadow: 0 0 12px color-mix(in srgb, var(--tone-item-color, #a855f7) 35%, transparent);
        }

        .modal-tone-switcher-item.loading,
        .modal-tone-switcher-item:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        .modal-tone-switcher-item .tone-mini-icon {
            font-size: 12px;
            flex-shrink: 0;
            color: var(--tone-item-color, #a855f7);
            filter: drop-shadow(0 0 6px color-mix(in srgb, var(--tone-item-color, #a855f7) 45%, transparent));
        }

        .modal-tone-switcher-item .tone-gen-flag {
            font-size: 9px;
            line-height: 1;
            flex-shrink: 0;
        }

        .modal-tone-switcher-item .tone-gen-flag.generated {
            color: #10b981;
        }

        .modal-tone-switcher-item .tone-gen-flag.pending {
            color: #52525b;
        }

        .modal-tone-switcher-item.unavailable {
            opacity: 0.45;
            cursor: not-allowed;
        }

        .modal-tone-switcher-item .tone-gen-flag.unavailable {
            color: #71717a;
        }

        .modal-tone-switcher-item .tone-mini-spinner {
            font-size: 10px;
            color: var(--text-dim);
        }

        /* Unica area scrollabile: testo + assets */
        .modal-tone-scroll {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 4px;
            scrollbar-gutter: stable;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.12) transparent;
        }

        .modal-tone-scroll::-webkit-scrollbar {
            width: 5px;
        }

        .modal-tone-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .modal-tone-scroll::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.12);
            border-radius: 10px;
        }

        .modal-tone-scroll::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        .modal-sidebar-panel {
            width: 0;
            opacity: 0;
            overflow: visible;
            border-right: 1px solid transparent;
            margin-right: 0;
            padding-right: 0;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                        opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                        margin-right 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                        padding-right 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                        border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            z-index: 25;
        }

        .output-modal-box.completed-glow .modal-sidebar-panel {
            width: 250px;
            opacity: 1;
            margin-right: 25px;
            padding-right: 20px;
            border-right: 1px solid var(--border-grey);
        }

        .modal-sidebar-panel.sidebar-expanded {
            width: 580px !important;
            z-index: 30;
            background: var(--bg-color);
            box-shadow: 8px 0 30px rgba(0, 0, 0, 0.5);
        }

        .sidebar-inner-row {
            display: flex;
            flex-direction: column;
            width: 100%;
            min-width: 0;
        }

        .sidebar-header {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 4px 0 8px 0;
            border-bottom: 1px solid var(--border-grey);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }
        .sidebar-header i {
            color: #a855f7;
            font-size: 13px;
        }

        .sidebar-tools-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            overflow: visible;
            /* Pochi campi: sempre tutti visibili, niente scrollbar */
            max-height: none;
            flex-shrink: 0;
        }

        .sidebar-extension-pane {
            display: none;
            flex-direction: column;
            border-left: 1px dashed var(--border-grey);
            margin-left: 12px;
            padding-left: 16px;
            min-width: 0;
        }
        .modal-sidebar-panel.sidebar-expanded .sidebar-inner-row {
            display: flex;
            flex-direction: row;
            align-items: flex-start;
            gap: 0;
        }
        .modal-sidebar-panel.sidebar-expanded .sidebar-tools-list {
            width: 218px;
            flex-shrink: 0;
            overflow: visible;
            max-height: none;
        }
        .modal-sidebar-panel.sidebar-expanded .sidebar-extension-pane.active {
            display: flex;
            flex: 1;
            min-height: 0;
            max-height: calc(90vh - 100px);
            overflow-y: auto;
        }

        #output-modal.tone-modal-fullscreen .modal-sidebar-panel.sidebar-expanded .sidebar-extension-pane.active {
            max-height: calc(100% - 16px);
        }

        #sidebar-extension-body {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
        }

        .sidebar-extension-close {
            color: var(--text-dim);
            cursor: pointer;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-grey);
            transition: color 0.2s;
            white-space: nowrap;
        }
        .sidebar-extension-close:hover {
            color: #fff;
        }

        .sidebar-item,
        .sidebar-tree-btn {
            background: transparent;
            border: none;
            padding: 8px 4px;
            border-radius: 0;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            color: #d4d4d8;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            text-align: left;
            position: relative;
            transition: color 0.2s ease, opacity 0.2s ease;
        }
        .sidebar-item:hover,
        .sidebar-tree-btn:hover {
            background: transparent;
            color: #fff;
            border: none;
        }
        .sidebar-item:focus-visible,
        .sidebar-tree-btn:focus-visible {
            outline: 1px solid rgba(255, 255, 255, 0.25);
            outline-offset: 2px;
        }

        /* Toast verde semitrasparente per conferma copia */
        .workspace-copy-toast {
            position: fixed;
            top: 60px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(16, 185, 129, 0.85);
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            padding: 10px 22px;
            border-radius: 8px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.35s ease;
            white-space: nowrap;
            box-shadow: 0 4px 16px rgba(16, 185, 129, 0.25);
            z-index: 100000;
        }
        .workspace-copy-toast.show {
            opacity: 1;
        }

        /* Albero workspace (sempre aperto, senza accordion) */
        .sidebar-tree {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin: 2px 0;
        }

        .sidebar-tree-label {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 4px 4px;
            font-size: 12px;
            font-weight: 700;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            pointer-events: none;
            user-select: none;
        }

        .sidebar-tree-label i {
            color: #a1a1aa;
            font-size: 12px;
        }

        .sidebar-tree-children {
            display: flex;
            flex-direction: column;
            gap: 1px;
            padding-left: 14px;
            margin-left: 8px;
            border-left: 1px solid #27272a;
        }

        .sidebar-tree-btn {
            padding: 7px 8px 7px 10px;
            font-size: 12px;
            font-weight: 500;
            color: #e4e4e7;
            align-items: flex-start;
            line-height: 1.35;
            white-space: normal;
        }

        .sidebar-tree-btn i {
            margin-top: 2px;
            color: #a1a1aa;
            flex-shrink: 0;
            width: 14px;
            text-align: center;
        }

        .sidebar-tree-btn:hover i {
            color: #fff;
        }

        /* Cards elenco versioni (Confronta con altra versione) */
        .compare-version-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: calc(90vh - 220px);
            overflow-y: auto;
            padding-right: 4px;
            scrollbar-width: thin;
        }

        .compare-version-card {
            border: 1px solid #27272a;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 8px;
            padding: 12px 14px;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s;
        }

        .compare-version-card:hover {
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.06);
        }

        .compare-version-card-title {
            font-size: 12px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .compare-version-card-meta {
            display: grid;
            gap: 6px;
            font-size: 11px;
            color: var(--text-dim);
            line-height: 1.45;
        }

        .compare-version-card-meta strong {
            color: #a1a1aa;
            font-weight: 600;
        }

        .compare-version-empty {
            border: 1px dashed #27272a;
            border-radius: 8px;
            padding: 24px 16px;
            text-align: center;
            color: var(--text-dim);
            font-size: 12px;
            line-height: 1.5;
        }

        /* Modale confronto affiancato */
        .compare-diff-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 120000;
            background: rgba(0, 0, 0, 0.72);
            backdrop-filter: blur(4px);
            align-items: center;
            justify-content: center;
            padding: 24px;
            box-sizing: border-box;
        }

        .compare-diff-overlay.open {
            display: flex;
        }

        .compare-diff-box {
            width: min(1100px, calc(100vw - 48px));
            height: min(88vh, 900px);
            background: #0d0d0d;
            border: 1px solid #27272a;
            border-radius: 12px;
            padding: 22px 24px 20px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .compare-diff-close {
            position: absolute;
            top: 16px;
            right: 18px;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 18px;
            z-index: 2;
        }

        .compare-diff-close:hover {
            color: #fff;
        }

        .compare-diff-header {
            flex-shrink: 0;
            margin-bottom: 14px;
            padding-right: 28px;
        }

        .compare-diff-header h3 {
            margin: 0 0 4px;
            font-size: 15px;
            color: #fff;
        }

        .compare-diff-header p {
            margin: 0;
            font-size: 12px;
            color: var(--text-dim);
        }

        .compare-diff-legend {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-top: 10px;
            font-size: 11px;
            color: var(--text-dim);
        }

        .compare-diff-legend span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .compare-diff-swatch {
            width: 12px;
            height: 12px;
            border-radius: 3px;
            display: inline-block;
        }

        .compare-diff-swatch.removed {
            background: rgba(239, 68, 68, 0.45);
            border: 1px solid rgba(239, 68, 68, 0.8);
        }

        .compare-diff-swatch.added {
            background: rgba(16, 185, 129, 0.45);
            border: 1px solid rgba(16, 185, 129, 0.8);
        }

        .compare-diff-columns {
            flex: 1;
            min-height: 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            overflow: hidden;
        }

        .compare-diff-col {
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            border: 1px solid #27272a;
            border-radius: 10px;
            overflow: hidden;
            background: #111;
        }

        .compare-diff-meta {
            flex-shrink: 0;
            padding: 12px 14px;
            border-bottom: 1px solid #27272a;
            background: #0a0a0a;
            font-size: 11px;
            color: var(--text-dim);
            line-height: 1.5;
            display: grid;
            gap: 4px;
        }

        .compare-diff-meta .meta-title {
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .compare-diff-meta strong {
            color: #a1a1aa;
            font-weight: 600;
        }

        .compare-diff-body {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            padding: 14px 16px;
            font-size: 14px;
            line-height: 1.7;
            color: #e4e4e7;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .diff-removed {
            background: rgba(239, 68, 68, 0.28);
            color: #fecaca;
            border-radius: 3px;
            padding: 0 2px;
        }

        .diff-added {
            background: rgba(16, 185, 129, 0.28);
            color: #a7f3d0;
            border-radius: 3px;
            padding: 0 2px;
        }

        @media (max-width: 860px) {
            .compare-diff-columns {
                grid-template-columns: 1fr;
            }
        }

        .overlay-platform-pill,
        .overlay-lang-pill {
            background: #18181b;
            border: 1px solid #27272a;
            border-radius: 30px;
            padding: 4px;
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
            margin: 12px 0 16px 0;
        }

        /* Area di testo per le istruzioni chirurgiche */
        .overlay-textarea {
            width: 100%;
            height: 110px;
            background: #18181b;
            border: 1px solid #27272a;
            border-radius: 8px;
            color: #fff;
            padding: 12px;
            font-size: 13px;
            resize: none;
            outline: none;
            margin-top: 10px;
            transition: border-color 0.3s;
        }
        .overlay-textarea:focus {
            border-color: var(--accent-blue);
        }

        .overlay-char-counter {
            text-align: right;
            font-size: 11px;
            color: var(--text-dim);
            margin-top: 4px;
            transition: color 0.3s;
        }
        .overlay-char-counter.low-chars {
            color: #ef4444 !important;
            font-weight: 700;
        }

        .overlay-action-btn {
            width: 100%;
            background: var(--accent-blue);
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-transform: uppercase;
            margin-top: 15px;
            transition: background 0.3s;
        }
        .overlay-action-btn:hover {
            background: #1d4ed8;
        }

        /* ==========================================================================
           USER GUIDE — Fumetti onboarding Freemium (user_guide: true)
           ========================================================================== */
        .user-guide-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.62);
            backdrop-filter: blur(3px);
            z-index: 10001;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.45s;
        }
        .user-guide-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .guide-target-highlight {
            position: relative;
            z-index: 10002 !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.55),
                        0 0 28px rgba(168, 85, 247, 0.28),
                        0 0 48px rgba(37, 99, 235, 0.12);
            border-radius: 8px;
            transition: box-shadow 0.45s ease;
        }

        /* Fase 2 guida: textarea resta editabile sopra l'overlay */
        .guide-textarea-accessible {
            position: relative;
            z-index: 10002 !important;
            pointer-events: auto !important;
        }
        .guide-textarea-accessible textarea {
            pointer-events: auto !important;
            cursor: text;
        }

        /* Fase 4: pagina utilizzabile, nessun oscuramento invasivo */
        .user-guide-overlay.guide-overlay-usable {
            background: transparent;
            backdrop-filter: none;
        }

        .guide-interactive-zone {
            position: relative;
            z-index: 10002 !important;
            pointer-events: auto !important;
        }

        .user-guide-callout[data-phase="4"] {
            max-width: 420px;
        }

        .user-guide-callout {
            position: fixed;
            z-index: 10003;
            max-width: 320px;
            background: linear-gradient(145deg, #141414 0%, #0d0d0d 100%);
            border: 1px solid rgba(168, 85, 247, 0.28);
            border-radius: 12px;
            padding: 18px 20px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55),
                        0 0 24px rgba(37, 99, 235, 0.08);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px) scale(0.97);
            transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                        visibility 0.4s;
            pointer-events: none;
        }
        .user-guide-callout.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }
        .user-guide-callout.has-actions {
            pointer-events: auto;
        }
        .user-guide-callout.has-actions .user-guide-callout-actions {
            display: flex;
        }

        .user-guide-callout-arrow {
            position: absolute;
            width: 12px;
            height: 12px;
            background: #0d0d0d;
            border-left: 1px solid rgba(168, 85, 247, 0.28);
            border-top: 1px solid rgba(168, 85, 247, 0.28);
            transform: rotate(45deg);
        }
        .user-guide-callout[data-placement="bottom"] .user-guide-callout-arrow {
            top: -7px; left: 50%; margin-left: -6px;
        }
        .user-guide-callout[data-placement="top"] .user-guide-callout-arrow {
            bottom: -7px; left: 28px;
            transform: rotate(225deg);
        }
        .user-guide-callout[data-placement="left"] .user-guide-callout-arrow {
            right: -7px; top: 24px;
            transform: rotate(135deg);
        }
        .user-guide-callout[data-placement="right"] .user-guide-callout-arrow {
            left: -7px; top: 24px;
            transform: rotate(-45deg);
        }

        .user-guide-callout-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #a855f7;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .user-guide-callout-label i {
            font-size: 11px;
        }

        .user-guide-callout-text {
            font-size: 13px;
            line-height: 1.65;
            color: #d4d4d8;
            font-weight: 400;
        }

        .user-guide-callout-actions {
            display: none;
            gap: 10px;
            margin-top: 16px;
        }
        .user-guide-callout.has-actions .user-guide-callout-actions {
            display: flex;
        }

        .guide-btn-cancel {
            flex: 1;
            background: transparent;
            border: 1px solid var(--border-grey);
            color: var(--text-dim);
            padding: 9px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.25s;
        }
        .guide-btn-cancel:hover {
            border-color: #52525b;
            color: #fff;
        }

        .guide-btn-confirm {
            flex: 1;
            background: var(--accent-blue);
            border: none;
            color: #fff;
            padding: 9px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            text-transform: uppercase;
            transition: background 0.25s;
        }
        .guide-btn-confirm:hover {
            background: #1d4ed8;
        }
    </style>
</head>
<body>

<div id="global-error-notification"></div>
<div id="workspace-copy-toast" class="workspace-copy-toast">Contenuto copiato correttamente</div>

<!-- User Guide onboarding Freemium -->
<div id="user-guide-overlay" class="user-guide-overlay"></div>
<div id="user-guide-callout" class="user-guide-callout" data-placement="bottom">
    <div class="user-guide-callout-arrow"></div>
    <div class="user-guide-callout-label"><i class="fas fa-compass"></i> Guida PRISM</div>
    <p id="user-guide-callout-text" class="user-guide-callout-text"></p>
    <div class="user-guide-callout-actions">
        <button type="button" class="guide-btn-cancel" id="guide-btn-cancel">Annulla</button>
