        <div class="pill active" onclick="selP(this)"><i class="fab fa-linkedin" aria-hidden="true"></i> LinkedIn</div>
        <div class="pill" onclick="selP(this)"><i class="fab fa-x-twitter" aria-hidden="true"></i> X</div>
