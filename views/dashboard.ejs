<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRISM - Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #000000;
            --input-bg: #0d0d0d;
            --border-grey: #262626;
            --text-main: #ffffff;
            --text-dim: #71717a;
            --accent-blue: #2563eb;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', -apple-system, sans-serif;
            padding: 20px 40px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* --- HEADER --- */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .logo-text { font-size: 24px; font-weight: 800; color: var(--text-dim); }
        .logo-text span { color: #fff; font-size: 32px; margin-left: 10px; }

        .nav-right { display: flex; gap: 20px; font-size: 14px; color: var(--text-dim); }
        .nav-right span { cursor: pointer; display: flex; align-items: center; gap: 6px; }

        /* --- AREA INPUT --- */
        .top-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            margin-bottom: 10px;
        }

        .input-box {
            flex: 1;
            max-width: 800px;
        }

        .rainbow-line {
            height: 4px; /* Leggermente più spessa per far risaltare il colore */
            background: linear-gradient(
                to right, 
                #3b82f6, /* Polemico */
                #10b981, /* Accademico */
                #f59e0b, /* Narrativo */
                #ef4444, /* Umano */
                #a855f7, /* Scherzoso */
                #ec4899  /* Pragmatico */
            );
            /* Aggiunge un bagliore soffuso per dare vita ai colori */
            box-shadow: 0 0 12px rgba(255, 255, 255, 0.1); 
            position: relative;
            z-index: 1;
        }

        .rainbow-line::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(to bottom, rgba(255,255,255,0.2), transparent);
            pointer-events: none;
        }

        /* Nuova riga impostazioni senza bordo e centrata */
        .settings-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 40px; /* Spazio tra Social e Lingua */
            width: 100%;
            margin-bottom: 25px;
        }

        .setting-group {
            display: flex;
            align-items: center;
            gap: 15px; /* Spazio tra Label e Componente */
        }

        .setting-label {
            font-size: 12px;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0 !important; /* Toglie il margine sotto per allinearla di fianco */
        }

        textarea {
            width: 100%;
            height: 120px;
            background: transparent;
            border: none;
            color: #fff;
            padding: 20px;
            font-size: 16px;
            resize: none;
            outline: none;
        }

        .input-info {
            display: flex;
            justify-content: flex-end;
            padding: 10px 20px;
            font-size: 12px;
            color: var(--text-dim);
            gap: 15px;
        }

        .settings-grid {
            display: flex;
            justify-content: space-around;
            align-items: center;
            text-align: center;
            background: rgba(255, 255, 255, 0.01);
            border: 1px solid var(--border-grey);
            border-radius: 8px;
            padding: 20px;
        }

        .platform-pill {
            background: #18181b;
            border: 1px solid #27272a;
            border-radius: 30px;
            padding: 4px;
            display: flex;
            gap: 5px;
        }

        .pill {
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 13px;
            cursor: pointer;
            color: var(--text-dim);
            display: flex;
            align-items: center; gap: 6px;
        }

        .pill.active { background: #3f3f46; color: #fff; }

        .lang-select {
            background: #000; border: 1px solid #3f3f46; color: #fff;
            padding: 10px 20px; border-radius: 8px; font-size: 14px;
        }

        /* --- ACTION ROW --- */
        .action-row { display: flex; justify-content: center; margin-bottom: 30px; }

        /* Bottone Analizza (Primario) */
        .generate-btn {
            width: 100% !important;
            background: var(--accent-blue);
            color: #fff;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.2s;
        }

        /* Bottone Pulisci (Secondario) */
        .reset-btn {
            width: 100%;
            background: transparent;
            border: 1px solid var(--border-grey);
            color: var(--text-dim);
            padding: 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .reset-btn:hover {
            border-color: #ef4444;
            color: #ef4444;
            background: rgba(239, 68, 68, 0.05);
        }

        .generate-btn:hover { background: #1d4ed8; transform: translateY(-1px); }

        /* --- GRID TONI --- */
        .tones-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px; margin-bottom: 40px;
        }

        .tone-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-grey);
            border-radius: 8px; padding: 22px 16px;
            text-align: center; opacity: 0.3; cursor: not-allowed;
            pointer-events: none; transition: all 0.4s;
            position: relative;
        }

        /* --- EFFETTO CARD ABILITATA --- */
        .tone-card.enabled {
            opacity: 1;
            cursor: pointer;
            pointer-events: auto;
            background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
            /* Aggiunge un bordo sottile colorato su tutta la card e un'ombra esterna */
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-left: 5px solid var(--card-color) !important;
            box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.2); /* Profondità interna */
            transition: all 0.3s ease;
        }

        .tone-card.enabled:hover {
            background: rgba(255, 255, 255, 0.08);
            transform: translateY(-5px);
            /* Effetto bagliore sul bordo al passaggio del mouse */
            box-shadow: 0 0 15px -2px var(--card-color);
            border-color: var(--card-color);
        }

        /* --- ICONE CON BAGLIORE --- */
        .tone-card i.icon-top {
            font-size: 32px !important;
            color: var(--text-dim);
            transition: all 0.3s ease;
        }

        .tone-card.enabled i.icon-top {
            color: #fff;
            /* Raggio ampio (20px) e colore molto sfumato (var--glow-color) */
            /* Usiamo due ombre: una bianca vicina per la brillantezza, una colorata larga per l'aura */
            filter: drop-shadow(0 0 5px rgba(255,255,255,0.4)) 
                    drop-shadow(0 0 20px var(--glow-color));
            
            transform: scale(1.05); /* Un ingrandimento minimo, quasi impercettibile */
            opacity: 0.95; /* Evita il bianco puro "sparato" */
            transition: all 0.5s ease; /* Transizione più lenta per naturalezza */
        }

        /* Wrapper per centrare meglio */
        .icon-wrapper {
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

        .tone-card.enabled .icon-wrapper {
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
            border-radius: 50%;
        }

        .tone-card h3 { font-size: 13px; font-weight: 700; color: var(--text-dim); margin: 4px 0; }
        .tone-card.enabled h3 { color: #fff; }

        .tone-card.t-polemico { --card-color: #3b82f6; border-left: 5px solid var(--card-color) !important; }
        .tone-card.t-accademico { --card-color: #10b981; border-left: 5px solid var(--card-color) !important; }
        .tone-card.t-narrativo { --card-color: #f59e0b; border-left: 5px solid var(--card-color) !important; }
        .tone-card.t-umano { --card-color: #ef4444; border-left: 5px solid var(--card-color) !important; }
        .tone-card.t-scherzoso { --card-color: #a855f7; border-left: 5px solid var(--card-color) !important; }
        .tone-card.t-pragmatico { --card-color: #ec4899; border-left: 5px solid var(--card-color) !important; }

        /* Tooltip */
        .info-tooltip-container { position: absolute; bottom: 12px; right: 12px; }
        .info-icon { color: var(--text-dim); font-size: 12px; }
        .tooltip-text {
            visibility: hidden; width: 180px; background: #18181b; color: #fff;
            border: 1px solid #27272a; border-radius: 6px; padding: 10px;
            position: absolute; bottom: 125%; right: 0; opacity: 0; font-size: 10px;
            transition: opacity 0.2s; z-index: 100;
        }
        .info-tooltip-container:hover .tooltip-text { visibility: visible; opacity: 1; }

        /* Modals */
        .modal-overlay { 
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: rgba(5, 5, 5, 0.9); backdrop-filter: blur(8px); 
            z-index: 9999; display: none; align-items: center; justify-content: center; 
        }

        /* Checklist Styles */
        .checklist-container {
            margin-top: 25px;
            text-align: left;
            display: inline-block;
            width: 100%;
            max-width: 250px;
        }
        .check-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
            font-size: 13px;
            color: var(--text-dim);
        }
        .check-item span { font-size: 14px; width: 20px; text-align: center; }

        /* Container principale che affianca Textarea e Bottoni */
        .input-flex-container {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            gap: 20px;
            width: 100%;
            max-width: 1050px; /* Leggermente più largo per ospitare i bottoni a lato */
            margin: 0 auto 20px auto;
        }

        /* La colonna dei bottoni a destra */
        .side-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 180px; /* Larghezza fissa per i bottoni */
        }

    </style>
</head>
<body>

<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script src="/firebase-config.js"></script>

<script>
    window.location.href = "/";
    const currentEnv = "<%= env %>";
    if (typeof initFirebaseConfig === 'function') {
        initFirebaseConfig(currentEnv);
        firebase.initializeApp(window.FIREBASE_ENV);
        window.db = firebase.firestore();
    }

    function handleLogout() {
        firebase.auth().signOut().then(() => { window.location.href = "/login"; });
    }
</script>

<header style="display: flex; justify-content: space-between; align-items: center; padding: 0px 0; margin-bottom: 5px;">
    <div style="display: flex; align-items: center; margin-left: -5px;">
        <!-- Logo a 110px: una via di mezzo perfetta -->
        <img src="/images/logo_senza_scritta_piccola.png" alt="PRISM Logo" style="width: 110px; height: auto; display: block;">
    </div>
    
    <div class="nav-right" style="display: flex; gap: 20px; font-size: 13px; align-items: center;">
        <span style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: var(--text-dim);">
            <i class="fas fa-search" style="font-size: 14px;"></i> Archivio
        </span>
        <span style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: var(--text-dim);">
            <i class="fas fa-cog" style="font-size: 14px;"></i> Impostazioni
        </span>
        <span onclick="handleLogout()" style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #ef4444; font-weight: 600;">
            <i class="fas fa-sign-out-alt"></i> Logout
        </span>
    </div>
</header>

<!-- AREA INPUT + BOTTONI LATERALI -->
<div class="input-flex-container">
    <div class="input-box">
        <div class="rainbow-line"></div>
        <textarea id="topicInput" maxlength="200" placeholder="Di cosa vuoi parlare oggi?"></textarea>
        <div class="input-info">
            <span id="charCounter">200 / 200</span>
        </div>
    </div>

    <!-- Colonna Bottoni a Destra -->
    <div class="side-actions">
        <button class="generate-btn" onclick="generateHumanPost()">
            Analizza <i class="fas fa-bolt" style="margin-left: 5px;"></i>
        </button>
        <button class="reset-btn" onclick="fullReset()">
            <i class="fas fa-trash-alt"></i> Pulisci Tutto
        </button>
    </div>
</div>

<!-- IMPOSTAZIONI CENTRATE -->
<div class="settings-row" style="display: flex; justify-content: center; align-items: center; gap: 40px; margin-bottom: 30px;">
    <div class="setting-group" style="display: flex; align-items: center; gap: 12px;">
        <span class="setting-label" style="font-size: 11px; color: var(--text-dim); text-transform: uppercase;">Canale Social</span>
        <div class="platform-pill">
            <div class="pill" onclick="selP(this)"><i class="fab fa-facebook"></i> Facebook</div>
            <div class="pill active" onclick="selP(this)"><i class="fab fa-linkedin"></i> LinkedIn</div>
            <div class="pill" onclick="selP(this)">X</div>
        </div>
    </div>

    <div class="setting-group" style="display: flex; align-items: center; gap: 12px;">
        <span class="setting-label" style="font-size: 11px; color: var(--text-dim); text-transform: uppercase;">Lingua</span>
        <div class="lang-select" style="padding: 8px 15px; border-radius: 20px;">
            🇮🇹 Italiano
        </div>
    </div>
</div>

<!-- Tones Grid: Gli onclick ora chiamano selectToneCard -->
<div class="tones-grid">
    <div class="tone-card t-polemico" data-type="polemico" id="card-polemico" onclick="selectToneCard('polemico')">
        <div class="icon-wrapper"><i class="fas fa-gavel icon-top"></i></div>
        <h3>Distaccato / Polemico</h3>
        <div class="info-tooltip-container"><i class="fas fa-info-circle info-icon"></i><span class="tooltip-text">Smonta la narrativa mainstream con i dati nudi.</span></div>
    </div>
    
    <div class="tone-card t-accademico" data-type="accademico" id="card-accademico" onclick="selectToneCard('accademico')">
        <div class="icon-wrapper"><i class="fas fa-graduation-cap icon-top"></i></div>
        <h3>Professionale / Accademico</h3>
        <div class="info-tooltip-container"><i class="fas fa-info-circle info-icon"></i><span class="tooltip-text">Costruisci autorità con precisione tecnica.</span></div>
    </div>

    <div class="tone-card t-narrativo" data-type="equilibrato" id="card-equilibrato" onclick="selectToneCard('equilibrato')">
        <div class="icon-wrapper"><i class="fas fa-pen-nib icon-top"></i></div>
        <h3>Equilibrato / Narrativo</h3>
        <div class="info-tooltip-container"><i class="fas fa-info-circle info-icon"></i><span class="tooltip-text">Divulga con chiarezza e stile editoriale.</span></div>
    </div>

    <div class="tone-card t-umano" data-type="umano" id="card-umano" onclick="selectToneCard('umano')">
        <div class="icon-wrapper"><i class="fas fa-heart icon-top"></i></div>
        <h3>Umano / Empatico</h3>
        <div class="info-tooltip-container"><i class="fas fa-info-circle info-icon"></i><span class="tooltip-text">Connettiti emotivamente con il tuo pubblico.</span></div>
    </div>

    <div class="tone-card t-scherzoso" data-type="scherzoso" id="card-scherzoso" onclick="selectToneCard('scherzoso')">
        <div class="icon-wrapper"><i class="fas fa-theater-masks icon-top"></i></div>
        <h3>Gioviale / Scherzoso</h3>
        <div class="info-tooltip-container"><i class="fas fa-info-circle info-icon"></i><span class="tooltip-text">Intrattieni e rendi digeribili temi complessi.</span></div>
    </div>

    <div class="tone-card t-pragmatico" data-type="pragmatico" id="card-pragmatico" onclick="selectToneCard('pragmatico')">
        <div class="icon-wrapper"><i class="fas fa-tools icon-top"></i></div>
        <h3>Risolutore / Pragmatico</h3>
        <div class="info-tooltip-container"><i class="fas fa-info-circle info-icon"></i><span class="tooltip-text">Focus su soluzioni pratiche e how-to.</span></div>
    </div>
</div>

<!-- Modal di caricamento con Checklist -->
<div id="prism-modal" class="modal-overlay">
    <div style="background: #111; border: 1px solid var(--border-grey); padding: 40px; border-radius: 12px; width: 450px; text-align: center;">
        <div style="margin-bottom: 20px;"><i class="fas fa-circle-notch fa-spin" style="font-size: 32px; color: var(--accent-blue);"></i></div>
        <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 5px;">Pipeline PRISM</h2>
        <div id="status-msg" style="font-size: 13px; color: var(--text-dim); margin-bottom: 20px;">Inizializzazione...</div>
        
        <div style="width: 100%; background: #18181b; border-radius: 10px; overflow: hidden; height: 6px;">
            <div id="p-bar" style="height: 100%; width: 0%; background: var(--accent-blue); transition: width 0.4s;"></div>
        </div>

        <div class="checklist-container">
            <div class="check-item"><span id="check-shaping">⚪</span> Shaping Strategico</div>
            <div class="check-item"><span id="check-search">⚪</span> Ricerca Web Profonda</div>
            <div class="check-item"><span id="check-refiner">⚪</span> Raffinamento Analitico</div>
        </div>
    </div>
</div>

<!-- Modal Output -->
<div id="output-modal" class="modal-overlay" onclick="closeToneModal()">
    <div style="background: #111; border: 1px solid var(--border-grey); border-left: 5px solid var(--accent-blue); padding: 35px; border-radius: 12px; width: 750px; max-height: 90vh; overflow-y: auto; position: relative;" onclick="event.stopPropagation()">
        <span onclick="closeToneModal()" style="position: absolute; top: 20px; right: 25px; color: var(--text-dim); cursor: pointer; font-size: 20px;"><i class="fas fa-times"></i></span>
        <h2 id="modal-tone-title" style="font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 20px; border-bottom: 1px solid var(--border-grey); padding-bottom: 10px;">Output</h2>
        
        <div id="modal-tone-text" style="line-height: 1.8; font-size: 15px; color: #e4e4e7;"></div>

        <!-- Sezione rigenerazione omessa per pulizia, rimane come nel tuo originale -->
    </div>
</div>

<script src="/dashboard.js"></script>
</body>
</html>